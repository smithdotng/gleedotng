# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Database name (created automatically)
MONGODB_DB="glamng"

# Load the 9 demo businesses + sample appointments when the database is empty.
# Set to "false" for production.
SEED_DEMO_DATA="true"

# Secret used to sign operator login sessions — any long random string (32+ chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ---- Email (SMTP) ----
# Hostinger example: smtp.hostinger.com, port 465 (SSL). Use 587 + SMTP_SECURE="false" for STARTTLS.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="hello@glee.ng"
SMTP_PASS=""
MAIL_FROM="glee.ng <hello@glee.ng>"

# Public URL of the site — used for links and the logo in emails
APP_URL="http://localhost:3000"
